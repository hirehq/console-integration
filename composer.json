{
    "name": "hirehq/console-integration",
    "description": "Laravel integration with Hire HQ Console for product provisioning and entitlement enforcement.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0"
    },
    "autoload": {"psr-4": {"HireHq\\ConsoleIntegration\\": "src/"}},
    "autoload-dev": {"psr-4": {"HireHq\\ConsoleIntegration\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["HireHq\\ConsoleIntegration\\ConsoleIntegrationServiceProvider"]}},
    "scripts": {"test": "pest", "format": "pint"},
    "config": {"sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
